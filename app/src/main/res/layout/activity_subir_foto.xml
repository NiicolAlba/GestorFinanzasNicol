<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/colorFondo">

    <!-- Botón Volver arriba a la izquierda -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⬅ VOLVER"
        android:layout_gravity="start"
        android:textColor="@color/textPrimary"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adjuntar Recibo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="24dp"/>

    <ImageView
        android:id="@+id/ivPrevia"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="#E0E0E0"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_caja"
        android:layout_marginBottom="24dp"/>

    <!-- Botones de Galería y Cámara -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElegirGaleria"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="🖼️ GALERÍA"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/btnBuscar"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTomarFoto"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="📷 CÁMARA"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/btnEditar"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubir"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="SUBIR FOTO"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/btnAgregar"
        android:textColor="@color/white"/>

</LinearLayout>